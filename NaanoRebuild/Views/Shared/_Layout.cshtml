<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Naano</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <nav class="navbar navbar-expand-lg naano-navbar sticky-top">
        <div class="container">
            <a class="navbar-brand naano-brand" asp-controller="Home" asp-action="Index">
                <span class="naano-brand-mark">N</span>aano
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Creators" asp-action="Index">Creators</a></li>
                    <li class="nav-item"><a class="nav-link" asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                    <li class="nav-item ms-lg-2">
                        <a class="btn naano-btn-primary btn-sm px-3" asp-controller="Creators" asp-action="Index">Explore Creators</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="container mt-3">
            <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        </div>
    }

    <main>
        @RenderBody()
    </main>

    <footer class="naano-footer mt-5">
        <div class="container py-5">
            <div class="row gy-4">
                <div class="col-lg-4">
                    <a class="naano-brand naano-brand-footer" asp-controller="Home" asp-action="Index">
                        <span class="naano-brand-mark">N</span>aano
                    </a>
                    <p class="text-muted mt-3 mb-0">The creator marketplace that connects brands with the right voices, fast.</p>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Platform</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a asp-controller="Creators" asp-action="Index">Browse Creators</a></li>
                        <li><a asp-controller="Dashboard" asp-action="Index">Dashboard</a></li>
                        <li><a asp-controller="Campaigns" asp-action="Create">Start a Campaign</a></li>
                    </ul>
                </div>
                <div class="col-lg-2 col-6">
                    <h6 class="footer-heading">Company</h6>
                    <ul class="list-unstyled footer-links">
                        <li><a href="#">About</a></li>
                        <li><a href="#">Careers</a></li>
                        <li><a href="#">Contact</a></li>
                    </ul>
                </div>
                <div class="col-lg-4">
                    <h6 class="footer-heading">Stay in the loop</h6>
                    <p class="text-muted small">Demo project — this footer is illustrative only.</p>
                </div>
            </div>
            <hr class="border-secondary-subtle mt-4" />
            <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Naano Demo. Built as an original student/portfolio MVP. Not affiliated with any real company.</p>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
