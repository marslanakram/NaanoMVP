@model List<Creator>
@{
    ViewData["Title"] = "Home";
    var totalCreators = ViewBag.TotalCreators as int? ?? 0;
}

<section class="naano-hero">
    <div class="container py-5">
        <div class="row align-items-center gy-5">
            <div class="col-lg-6">
                <span class="badge naano-badge-soft mb-3">Creator Marketplace</span>
                <h1 class="display-4 fw-bold naano-hero-title">Find the right creators to grow your brand faster.</h1>
                <p class="lead text-muted mt-3">
                    Naano connects brands with vetted creators across every niche — browse profiles,
                    compare performance, and launch a campaign in minutes instead of weeks.
                </p>
                <div class="d-flex flex-wrap gap-3 mt-4">
                    <a class="btn naano-btn-primary btn-lg px-4" asp-controller="Creators" asp-action="Index">
                        Explore Creators <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                    <a class="btn naano-btn-outline btn-lg px-4" asp-controller="Dashboard" asp-action="Index">
                        View Dashboard
                    </a>
                </div>
                <div class="d-flex gap-4 mt-5 flex-wrap">
                    <div>
                        <div class="fw-bold fs-4">@totalCreators+</div>
                        <div class="text-muted small">Active Creators</div>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">18</div>
                        <div class="text-muted small">Categories</div>
                    </div>
                    <div>
                        <div class="fw-bold fs-4">4.9<i class="bi bi-star-fill text-warning small ms-1"></i></div>
                        <div class="text-muted small">Avg. Brand Rating</div>
                    </div>
                </div>
            </div>
            <div class="col-lg-6">
                <div class="naano-hero-visual">
                    <div class="naano-floating-card card-1">
                        <div class="d-flex align-items-center gap-2">
                            <div class="naano-avatar naano-avatar-sm" style="background: linear-gradient(135deg,#7C3AED,#EC4899);">AN</div>
                            <div>
                                <div class="fw-semibold small">Amara Ndlovu</div>
                                <div class="text-muted" style="font-size:.75rem;">245K followers · 4.8% eng.</div>
                            </div>
                        </div>
                    </div>
                    <div class="naano-floating-card card-2">
                        <i class="bi bi-graph-up-arrow text-success"></i>
                        <span class="fw-semibold ms-2">+38% Engagement</span>
                    </div>
                    <div class="naano-hero-gradient-block">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <div class="naano-floating-card card-3">
                        <div class="fw-semibold small">Campaign Live</div>
                        <div class="text-muted" style="font-size:.75rem;">3 creators onboarded</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 naano-stats-section">
    <div class="container">
        <div class="row g-4 text-center">
            <div class="col-md-3 col-6">
                <div class="naano-stat-card">
                    <i class="bi bi-people naano-stat-icon"></i>
                    <div class="fw-bold fs-3">@totalCreators+</div>
                    <div class="text-muted small">Verified Creators</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="naano-stat-card">
                    <i class="bi bi-megaphone naano-stat-icon"></i>
                    <div class="fw-bold fs-3">120+</div>
                    <div class="text-muted small">Campaigns Launched</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="naano-stat-card">
                    <i class="bi bi-globe naano-stat-icon"></i>
                    <div class="fw-bold fs-3">30+</div>
                    <div class="text-muted small">Countries Reached</div>
                </div>
            </div>
            <div class="col-md-3 col-6">
                <div class="naano-stat-card">
                    <i class="bi bi-lightning-charge naano-stat-icon"></i>
                    <div class="fw-bold fs-3">48h</div>
                    <div class="text-muted small">Avg. Time to Launch</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge naano-badge-soft mb-2">How it works</span>
            <h2 class="fw-bold">Launch a campaign in three simple steps</h2>
        </div>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="naano-step-card">
                    <div class="naano-step-number">1</div>
                    <h5 class="fw-semibold mt-3">Discover Creators</h5>
                    <p class="text-muted mb-0">Search and filter by category, platform, followers, or engagement to find your perfect match.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="naano-step-card">
                    <div class="naano-step-number">2</div>
                    <h5 class="fw-semibold mt-3">Build Your Campaign</h5>
                    <p class="text-muted mb-0">Add creators to a new or existing campaign with your objective, audience, and budget.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="naano-step-card">
                    <div class="naano-step-number">3</div>
                    <h5 class="fw-semibold mt-3">Track Performance</h5>
                    <p class="text-muted mb-0">Monitor impressions, clicks, leads, and spend from a single, simple dashboard.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-5 naano-featured-section">
    <div class="container">
        <div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
            <div>
                <span class="badge naano-badge-soft mb-2">Featured</span>
                <h2 class="fw-bold mb-0">Top performing creators</h2>
            </div>
            <a class="btn naano-btn-outline" asp-controller="Creators" asp-action="Index">See all creators</a>
        </div>
        <div class="row g-4">
            @foreach (var creator in Model)
            {
                <div class="col-lg-3 col-md-6">
                    <partial name="_CreatorCard" model="creator" />
                </div>
            }
        </div>
    </div>
</section>

<section class="naano-final-cta py-5">
    <div class="container text-center py-4">
        <h2 class="fw-bold display-6">Ready to find your next creator partner?</h2>
        <p class="lead text-muted mb-4">Browse the marketplace and put together your first campaign today.</p>
        <a class="btn naano-btn-primary btn-lg px-5" asp-controller="Creators" asp-action="Index">Explore Creators</a>
    </div>
</section>
