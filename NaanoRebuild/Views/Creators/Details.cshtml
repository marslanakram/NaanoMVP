@model Creator
@{
    ViewData["Title"] = Model.Name;
    var gradients = new[]
    {
        "linear-gradient(135deg,#7C3AED,#EC4899)",
        "linear-gradient(135deg,#2563EB,#06B6D4)",
        "linear-gradient(135deg,#F59E0B,#EF4444)",
        "linear-gradient(135deg,#10B981,#14B8A6)",
        "linear-gradient(135deg,#6366F1,#8B5CF6)",
    };
    var gradient = gradients[Model.Id % gradients.Length];
    var initials = string.Join("", Model.Name.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(p => p[0])).ToUpper();
}

<section class="py-5">
    <div class="container">
        <a asp-controller="Creators" asp-action="Index" class="text-decoration-none naano-back-link mb-3 d-inline-block">
            <i class="bi bi-arrow-left me-1"></i> Back to Creators
        </a>

        <div class="row g-4">
            <div class="col-lg-4">
                <div class="naano-profile-card text-center">
                    <div class="naano-avatar naano-avatar-lg mx-auto" style="background: @gradient;">@initials</div>
                    <h3 class="fw-bold mt-3 mb-0">@Model.Name</h3>
                    <div class="text-muted">@Model.Username</div>
                    <div class="d-flex justify-content-center gap-2 mt-3 flex-wrap">
                        <span class="badge naano-badge-soft">@Model.Category</span>
                        <span class="badge naano-platform-badge">@Model.Platform</span>
                    </div>
                    <div class="text-muted mt-2"><i class="bi bi-geo-alt me-1"></i>@Model.Location</div>
                    <a class="btn naano-btn-primary w-100 mt-4" asp-controller="Campaigns" asp-action="AddToCampaign" asp-route-creatorId="@Model.Id">
                        <i class="bi bi-plus-circle me-1"></i> Add to Campaign
                    </a>
                </div>
            </div>
            <div class="col-lg-8">
                <div class="naano-profile-card mb-4">
                    <h5 class="fw-semibold mb-3">Performance Statistics</h5>
                    <div class="row text-center g-3">
                        <div class="col-4">
                            <div class="naano-stat-block">
                                <div class="fw-bold fs-4">@(Model.Followers >= 1000 ? $"{Model.Followers / 1000.0:0.#}K" : Model.Followers.ToString())</div>
                                <div class="text-muted small">Followers</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="naano-stat-block">
                                <div class="fw-bold fs-4">@Model.EngagementRate%</div>
                                <div class="text-muted small">Engagement Rate</div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="naano-stat-block">
                                <div class="fw-bold fs-4">$@Model.Price.ToString("0")</div>
                                <div class="text-muted small">Price / Post</div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="naano-profile-card">
                    <h5 class="fw-semibold mb-3">About @Model.Name.Split(' ')[0]</h5>
                    <p class="text-muted mb-0">@Model.Bio</p>
                </div>
            </div>
        </div>
    </div>
</section>
